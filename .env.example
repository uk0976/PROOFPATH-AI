# ==============================================================================
# PROOFPATH AI — Root Environment Template
# Copy this file to `.env` or reference sub-directory configurations:
# - backend/.env
# - frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Reasoning & LLM Providers (Backend)
# ------------------------------------------------------------------------------
# Primary multimodal LLM provider for Atomic Claim Extraction and BlindSpot Discovery
GEMINI_API_KEY=your_gemini_api_key_here

# Optional secondary ultra-low latency fallback provider
GROQ_API_KEY=your_groq_api_key_here

# Model specifications (defaults: gemini-2.5-flash, fallback: llama-3.3-70b-versatile)
PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Backend Server & Security Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000

# Allowed CORS origins (JSON array or comma-separated list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database connection URL (SQLite WAL mode by default; PostgreSQL supported)
# Local: sqlite:///./proofpath.db
# Production: postgresql://user:password@host:5432/proofpath_db
DATABASE_URL=sqlite:///./proofpath.db

# File Storage Paths
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# ------------------------------------------------------------------------------
# 3. Frontend Web Application (Vite + React)
# ------------------------------------------------------------------------------
# Set this to your production backend URL when deploying frontend on Vercel/Netlify
# Local: http://localhost:8000/api/v1
# Production Example: https://proofpath-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
