# ProofPath AI - Backend Environment Configuration

# Primary LLM Provider (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Secondary LLM Provider (Groq API)
GROQ_API_KEY=your_groq_api_key_here

# App Settings
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database URL (SQLite default, or postgresql://user:pass@localhost/proofpath)
DATABASE_URL=sqlite:///./proofpath.db

# Storage Directories
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
